{
  "harness_version": "3.7.1",
  "_comment": "Global defaults for the backend agent team. A project may override any key by creating .claude/backend.json in the project root (shallow merge, top-level keys).",
  "model_plan": {
    "_active_tier": "quality",
    "tiers": {
      "quality": {
        "label": "Quality first (default)",
        "orchestrator": "opus",
        "be-analyst": "opus",
        "be-architect": "opus",
        "be-developer": "opus",
        "be-tester": "sonnet",
        "be-reviewer": "opus",
        "be-review-behavior": "opus",
        "be-review-reliability": "opus",
        "be-review-security": "opus"
      },
      "balanced": {
        "label": "Balanced",
        "orchestrator": "opus",
        "be-analyst": "sonnet",
        "be-architect": "opus",
        "be-developer": "sonnet",
        "be-tester": "haiku",
        "be-reviewer": "opus",
        "be-review-behavior": "opus",
        "be-review-reliability": "opus",
        "be-review-security": "opus"
      },
      "economy": {
        "label": "Economy",
        "orchestrator": "sonnet",
        "be-analyst": "sonnet",
        "be-architect": "opus",
        "be-developer": "sonnet",
        "be-tester": "haiku",
        "be-reviewer": "sonnet",
        "be-review-behavior": "sonnet",
        "be-review-reliability": "sonnet",
        "be-review-security": "sonnet"
      },
      "max": {
        "label": "All Opus (no cost ceiling)",
        "orchestrator": "opus",
        "be-analyst": "opus",
        "be-architect": "opus",
        "be-developer": "opus",
        "be-tester": "opus",
        "be-reviewer": "opus",
        "be-review-behavior": "opus",
        "be-review-reliability": "opus",
        "be-review-security": "opus"
      }
    }
  },
  "language": {
    "_comment": "Documents follow the user's language unless a project sets default_docs; stated in the Kickoff preview, not asked (PLAYBOOK §2.3).",
    "default_docs": "user",
    "code_and_identifiers": "en",
    "confirm_at_kickoff": false
  },
  "artifacts": {
    "dir": "docs/backend",
    "state_file": "docs/backend/state.json",
    "template_dir": "~/.claude/backend/templates"
  },
  "gates": {
    "_comment": "Human stops, listed for reference: all are fixed and cannot be switched off (PLAYBOOK §3F, Constitution §2.7, §6.7); everything else stops only for a Constitution §5 case.",
    "Kickoff": true,
    "Prototype": true,
    "Plan": true,
    "Acceptance": true
  },
  "parallelism": {
    "_comment": "Design review runs only when state.json risk is high (PLAYBOOK §3). The review panel is trimmed by risk (PLAYBOOK §6); the coordinator runs whenever a panelist ran.",
    "design_review": "high_risk",
    "design_review_panel": [
      "be-review-behavior",
      "be-review-reliability"
    ],
    "build_test_design_in_parallel": true,
    "review_panel": [
      "be-review-behavior",
      "be-review-reliability",
      "be-review-security"
    ],
    "review_coordinator": "be-reviewer"
  },
  "loops": {
    "max_gate_fix_rounds": 3,
    "max_fix_rounds_after_review": 2
  },
  "policy": {
    "require_traceability_ids": true,
    "requirement_id_prefix": "REQ",
    "design_id_prefix": "DES",
    "testcase_id_prefix": "TC",
    "finding_id_prefix": "FND",
    "block_phase_on_missing_upstream_doc": true,
    "developer_may_change_scope": false,
    "tests_derived_from_requirements_not_implementation": true
  }
}
